{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    // pi loads .ts extensions through Node's type stripping, which only erases
    // types — it cannot emit code. This flag rejects the syntax that would
    // otherwise blow up at load time (parameter properties, enums, namespaces).
    // bin/pi-scheduler imports these same modules under Node's strip-only mode,
    // which is stricter still, so this is load-bearing rather than style.
    "erasableSyntaxOnly": true,
    // ...and the same loader resolves import specifiers literally, so one
    // module importing another writes "./schedule-core.ts".
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["extensions/**/*.ts"]
}
